# Copy to server/.env (never commit the real file)
NODE_ENV=development
PORT=4000
# MongoDB MUST be a replica set (transactions)
MONGO_URL=mongodb://localhost:27017/crm?replicaSet=rs0
# Long random string for express-session
SESSION_SECRET=change-me-to-a-long-random-string-0123456789
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENC_KEY=
# Secret for HMAC-SHA256 of lower-cased emails (kept outside the database)
EMAIL_HMAC_KEY=
# Secret for signing file download links
FILE_LINK_KEY=
# SMTP provider (Brevo / SES). Ignored in development and test (emails go to the outbox)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@baiust.ac.bd
# Public URL of the app (used in email links)
APP_URL=http://localhost:5173
# ClamAV daemon host (used from spec 21)
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
# Optional: DNS servers used to resolve mongodb+srv:// (set to 8.8.8.8,1.1.1.1 if you get 'querySrv ECONNREFUSED')
DNS_SERVERS=
