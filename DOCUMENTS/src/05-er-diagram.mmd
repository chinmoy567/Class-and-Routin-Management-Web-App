%% Entity-relationship diagram (logical data model, MongoDB collections)
erDiagram
  DEPARTMENT ||--o{ USER : "has members"
  DEPARTMENT ||--o{ SECTION : contains
  DEPARTMENT ||--o{ TEACHER_CODE : defines
  DEPARTMENT ||--o{ ROOM_OWNERSHIP : "owns or shares"
  ROOM ||--o{ ROOM_OWNERSHIP : "owned by"
  USER |o--o| TEACHER_CODE : "linked to"
  USER ||--o{ ADMIN_SCOPE : "admin of"
  DEPARTMENT ||--o{ ADMIN_SCOPE : "administered by"
  SEMESTER ||--o{ SECTION : "offered in"
  SECTION ||--o{ SESSIONAL_GROUP : "split into"
  SECTION ||--o{ SECTION_ROLE : "has CR or DCR"
  USER ||--o{ SECTION_ROLE : holds
  SECTION ||--o{ ENROLMENT : "accepted students"
  USER ||--o{ ENROLMENT : "enrolled per semester"
  SESSIONAL_GROUP |o--o{ ENROLMENT : "lab group"
  USER ||--o{ JOIN_REQUEST : submits
  SECTION ||--o{ JOIN_REQUEST : targets
  SEMESTER ||--o{ ROUTINE_IMPORT : imports
  ROUTINE_IMPORT ||--o{ IMPORT_ISSUE : reports
  SECTION ||--o{ ROUTINE_SLOT : "weekly classes"
  SESSIONAL_GROUP |o--o{ ROUTINE_SLOT : "lab only"
  COURSE ||--o{ ROUTINE_SLOT : "taught in"
  ROOM ||--o{ ROUTINE_SLOT : "held in"
  ROUTINE_SLOT ||--o{ SLOT_TEACHER : "taught by"
  TEACHER_CODE ||--o{ SLOT_TEACHER : assigned
  ROUTINE_SLOT ||--o{ CLASS_CANCELLATION : "cancelled on date"
  ROOM ||--o{ ROOM_REQUEST : requested
  USER ||--o{ ROOM_REQUEST : "sent by"
  SECTION ||--o{ ROOM_REQUEST : "target section"
  ROOM ||--o{ ROOM_SLOT_LOCK : "locked blocks"
  ROOM_REQUEST ||--o{ ROOM_SLOT_LOCK : "holds (when approved)"
  SEMESTER ||--o{ CALENDAR_EVENT : "holiday exam ramadan"
  CONVERSATION ||--o{ CONVERSATION_MEMBER : has
  USER ||--o{ CONVERSATION_MEMBER : joins
  SECTION |o--o| CONVERSATION : "section group"
  CONVERSATION ||--o{ MESSAGE : contains
  USER ||--o{ MESSAGE : sends
  MESSAGE ||--o| ATTACHMENT : carries
  MESSAGE ||--o{ REPORT : reported
  USER ||--o{ BLOCK : blocks
  USER ||--o{ CHAT_SUSPENSION : suspended
  USER ||--o{ ANNOUNCEMENT : sends
  SECTION ||--o{ ANNOUNCEMENT : receives
  USER ||--o{ NOTIFICATION : receives
  USER ||--o{ FLAG : raises
  USER ||--o{ AUDIT_LOG : actor

  DEPARTMENT {
    objectId id PK
    string code "CSE EEE CE LAW"
    string name
    bool active
  }
  USER {
    objectId id PK
    enum type "super_admin dept_admin teacher student"
    objectId department_id FK
    string full_name
    string uv_id UK "students only"
    bytes email_enc "encrypted"
    string email_hash UK
    bool email_verified
    bytes phone_enc "encrypted"
    string photo_url
    string password_hash "argon2 or bcrypt"
    enum status "pending active suspended deactivated"
    int failed_logins
    datetime locked_until
  }
  ADMIN_SCOPE {
    objectId user_id FK
    objectId department_id FK "null means super admin"
  }
  TEACHER_CODE {
    objectId id PK
    objectId department_id FK
    string short_code "MYA AR"
    string full_name
    objectId user_id FK "unique when active"
  }
  SEMESTER {
    objectId id PK
    string name "Fall 2026"
    date start_date
    date end_date
    bool is_current
  }
  SECTION {
    objectId id PK
    objectId semester_id FK
    objectId department_id FK
    int level "1 to 4"
    enum term "I or II"
    string letter "A B C"
  }
  SESSIONAL_GROUP {
    objectId id PK
    objectId section_id FK
    string code "G1 G2 G3"
  }
  SECTION_ROLE {
    objectId section_id FK
    objectId user_id FK
    enum role "CR or DCR"
    datetime assigned_at
    datetime ended_at
  }
  ENROLMENT {
    objectId user_id FK
    objectId section_id FK
    objectId group_id FK
    datetime confirmed_at
    bool group_admin_override
  }
  JOIN_REQUEST {
    objectId id PK
    objectId student_id FK
    objectId section_id FK
    string uv_id
    string suggested_group
    enum status "pending accepted rejected escalated revoked"
    string reason
    objectId decided_by FK
    datetime created_at
  }
  COURSE {
    objectId id PK
    string code "CSE-301"
    string name
    bool sessional
  }
  ROOM {
    objectId id PK
    string number "311"
    enum type "classroom or lab"
  }
  ROOM_OWNERSHIP {
    objectId room_id FK
    objectId department_id FK
  }
  ROUTINE_IMPORT {
    objectId id PK
    objectId semester_id FK
    objectId department_id FK
    objectId uploaded_by FK
    enum status "preview published superseded"
    datetime published_at
  }
  IMPORT_ISSUE {
    objectId id PK
    objectId import_id FK
    enum severity "error or warning"
    string kind
    bool accepted
  }
  ROUTINE_SLOT {
    objectId id PK
    objectId section_id FK
    objectId group_id FK "null means whole section"
    objectId course_id FK
    objectId room_id FK
    enum day "Sun to Thu"
    time start_time
    time end_time
    bool published
    bool edited_by_hand
  }
  SLOT_TEACHER {
    objectId slot_id FK
    objectId teacher_code_id FK "null means TBA"
  }
  CLASS_CANCELLATION {
    objectId slot_id FK
    date on_date
    objectId by_admin FK
  }
  CALENDAR_EVENT {
    objectId id PK
    enum kind "holiday exam ramadan"
    date from_date
    date to_date
    json ramadan_time_map
  }
  ROOM_SLOT_LOCK {
    objectId id PK
    objectId room_id FK "unique with on_date + block_start"
    date on_date
    time block_start "fixed block, e.g. 10 min"
    objectId room_request_id FK
  }
  ROOM_REQUEST {
    objectId id PK
    objectId room_id FK
    objectId requester_id FK
    objectId target_section_id FK
    objectId target_group_id FK
    date on_date
    time start_time
    time end_time "max 3 h"
    string note
    enum status "pending approved rejected cancelled expired"
    objectId decided_by FK
    string no_show_note
  }
  CONVERSATION {
    objectId id PK
    enum kind "direct or section_group"
    objectId section_id FK
    bool closed
  }
  CONVERSATION_MEMBER {
    objectId conversation_id FK
    objectId user_id FK
    bool owner
  }
  MESSAGE {
    objectId id PK
    objectId conversation_id FK
    objectId sender_id FK
    text body_enc "max 4000 chars"
    datetime sent_at
    datetime delivered_at
    datetime seen_at
    bool deleted
    date purge_after
  }
  ATTACHMENT {
    objectId id PK
    objectId message_id FK
    string mime
    int size_bytes "max 5 MB"
    enum scan "pending clean infected"
  }
  REPORT {
    objectId id PK
    objectId message_id FK
    objectId reporter_id FK
    string reason
  }
  BLOCK {
    objectId blocker_id FK
    objectId blocked_id FK
  }
  CHAT_SUSPENSION {
    objectId user_id FK
    datetime until
    string reason
  }
  ANNOUNCEMENT {
    objectId id PK
    objectId sender_id FK
    objectId section_id FK
    objectId group_id FK
    text body
  }
  NOTIFICATION {
    objectId id PK
    objectId user_id FK
    string kind
    bool read
  }
  FLAG {
    objectId id PK
    objectId raised_by FK
    objectId section_id FK
    enum kind "problem or removal_request"
    enum status "open fixed rejected"
  }
  AUDIT_LOG {
    bigint id PK
    objectId actor_id FK
    objectId department_id FK
    string action
    json old_value
    json new_value
    datetime at "append only"
  }
